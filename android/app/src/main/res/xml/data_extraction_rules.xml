<?xml version="1.0" encoding="utf-8"?>
<!--
  أندرويد 12 (API 31) وأحدث بيستخدم الملف ده بدل allowBackup/fullBackupContent.
  allowBackup="false" لوحده بيوقف النسخ السحابي بس؛ نقل البيانات جهاز-لجهاز (device
  transfer) بيفضل شغال افتراضياً — واللي معناه إن توكن جلسة العميل ممكن ينتقل لجهاز تاني.
  هنا الاتنين متقفولين صراحة: مفيش أي حاجة من بيانات التطبيق بتتنسخ أو بتتنقل.
  كل البيانات الحقيقية (الحساب، الطلبات، العناوين، المفضلة) متخزّنة على السيرفر، فالمستخدم
  بيسجّل دخول على الجهاز الجديد وبيلاقي كل حاجة زي ما هي.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
