# قاعدة البيانات (Postgres) — مطلوب دايماً.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alaa_eldin

# منفذ السيرفر (اختياري — الافتراضي 8787 محلياً).
PORT=8787

# origin تطبيق التطوير المحلي (Vite dev server) — مستخدم فقط لما NODE_ENV != production.
DEV_ORIGIN=http://localhost:5183

# الرابط العام الحقيقي للمتجر — يُستخدم في رابط استعادة كلمة المرور المُرسَل بالإيميل.
PUBLIC_APP_URL=https://your-domain.example

# مفتاح Resend لإرسال إيميلات استعادة كلمة المرور فعلياً. لو فاضي، السيرفر بيسجّل الرابط
# في اللوج بدل ما يبعته بإيميل حقيقي (وضع تطوير آمن).
RESEND_API_KEY=
# عنوان "من" لإيميلات Resend (اختياري — افتراضي: علاء الدين <onboarding@resend.dev>).
RESEND_FROM=

# تخزين صور المنتجات (Cloudinary) — الثلاثة مطلوبين مع بعض لتفعيل رفع الصور. لو غير
# مُفعّلين، endpoint رفع الصور بيرفض الطلبات برسالة واضحة (image_storage_not_configured)
# والمنتجات القديمة بتفضل تعرض الإيموجي الاحتياطي زي ما هي.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# المجلد اللي بتتخزن فيه صور المنتجات على Cloudinary (اختياري).
CLOUDINARY_FOLDER=alaa-eldin/products

# واتساب (Meta WhatsApp Business Cloud API) — الاتنين مطلوبين مع بعض لتفعيل الإرسال الفعلي
# من لوحة التحكم. لو غير مُفعّلين، الإرسال بيرجع whatsapp_not_configured (409) والزر اليدوي
# (wa.me) بيفضل شغال زي ما هو دايماً.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# نسخة Graph API المستخدمة (اختياري — افتراضي: v21.0).
WHATSAPP_API_VERSION=

# مفاتيح VAPID لإشعارات Web Push الحقيقية — زوج مفاتيح مملوك للسيرفر نفسه (مش مزوّد خارجي
# زي Firebase). ولّدهم مرة واحدة بـ `npx web-push generate-vapid-keys`. لو غير مُفعّلين،
# التسجيل في الإشعارات بيرجع push_not_configured (409).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# بريد تواصل يظهر لمزوّدي المتصفح مع كل إشعار (اختياري — افتراضي: mailto:support@alaa-eldin.example).
VAPID_SUBJECT=

# مستوى تفصيل اللوجات: trace | debug | info | warn | error | fatal | silent (افتراضي: info).
LOG_LEVEL=info
