{
  "name": "alaa-eldin-supermarket-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api,admin -c blue,green,magenta \"npm:dev:client\" \"npm:dev:server\" \"npm:dev:admin\"",
    "dev:client": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:admin": "npm run dev --prefix admin",
    "build": "tsc -b && vite build",
    "build:server": "npm run build --prefix server",
    "build:admin": "npm run build --prefix admin",
    "preview": "vite preview",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:seed": "npm run db:seed --prefix server",
    "db:status": "npm run db:status --prefix server",
    "start": "npm run db:migrate --prefix server && cross-env NODE_ENV=production node server/dist/index.js"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3"
  }
}
